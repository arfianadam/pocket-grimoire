{% extends "base.html.twig" %}

{% block title %}{{ 'index.title'|trans }}{% endblock %}
{% set meta_description = 'index.description'|trans %}

{% block styles %}{{ encore_entry_link_tags('css/main') }}{% endblock %}

{% set body_class = 'body-grimoire' %}

{% block body %}

<h1 class="title">{{ 'title'|trans }}</h1>

{% include 'partials/setup.html.twig' %}
{% include 'partials/grimoire.html.twig' %}
{% include 'partials/jinxes.html.twig' %}
{% include 'partials/night-order.html.twig' %}
{% include 'partials/info-tokens.html.twig' %}
{% include 'partials/notes.html.twig' %}
{% include 'partials/acknowledgements.html.twig' %}
{% include 'partials/community.html.twig' %}

{% endblock %}

{% block javascript %}
{% set version = hash(4) %}
<script>
var URLS = {
    characters: "{{ path('data_characters', { version: version })|e('js') }}",
    jinxes: "{{ path('data_jinx', { version: version })|e('js') }}",
    game: "{{ path('data_game')|e('js') }}",
    homebrew: "{{ path('homebrew')|e('js') }}",
    url: "{{ path('data_url', { url: '{url}' })|e('js') }}"
};

var I18N = {
    goodTeam: "{{ 'messages.good_team'|trans|e('js') }}",
    evilTeam: "{{ 'messages.evil_team'|trans|e('js') }}",
    emptyCharacterAbility: "{{ 'messages.empty_character_ability'|trans|e('js') }}",
    versionChange: "{{ 'messages.version_change_message'|trans|e('js') }}",
    invalidScript: "{{ 'messages.invalid_script'|trans|e('js') }}",
    noCharacters: "{{ 'messages.no_characters'|trans|e('js') }}",
    customInfoToken: "{{ 'messages.custom_info_token'|trans|e('js') }}",
    bagDisabled: "{{ 'messages.bag_disabled'|trans|e('js') }}",
    distributedUnknown: "{{ 'draw.unknown_error'|trans|e('js') }}",
    distributedAvailable: "{{ 'setup.distributed_draw.available'|trans|e('js') }}",
    distributedNaming: "{{ 'setup.distributed_draw.naming'|trans|e('js') }}",
    distributedCompleted: "{{ 'setup.distributed_draw.completed'|trans|e('js') }}",
    distributedPlayerName: "{{ 'setup.distributed_draw.player_name'|trans|e('js') }}",
    distributedSave: "{{ 'setup.distributed_draw.save'|trans|e('js') }}",
    distributedRelease: "{{ 'setup.distributed_draw.release'|trans|e('js') }}",
    distributedProgress: "{{ 'setup.distributed_draw.progress'|trans|e('js') }}",
    distributedEnded: "{{ 'draw.ended'|trans|e('js') }}",
    distributedCreating: "{{ 'setup.distributed_draw.creating'|trans|e('js') }}",
    distributedReplaceConfirm: "{{ 'setup.distributed_draw.replace_confirm'|trans|e('js') }}",
    distributedReleaseConfirm: "{{ 'setup.distributed_draw.release_confirm'|trans|e('js') }}",
    distributedEndConfirm: "{{ 'setup.distributed_draw.end_confirm'|trans|e('js') }}",
};

var ENVIRONMENT = "{{ app.environment|e('js') }}";

var DRAW_SESSION_CONFIG = {
    createUrl: "{{ path('draw_session_create')|e('js') }}",
    csrfToken: "{{ csrf_token('draw-session-create')|e('js') }}"
};
</script>
{{ encore_entry_script_tags('js/main') }}
{% endblock %}
